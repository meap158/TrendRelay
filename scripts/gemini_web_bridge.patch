+const (
+	maxVideoReferences    = 3
+	maxVideoReferenceSize = 10 << 20
+)
+
+// readVideoReference reads one uploaded reference image for a video request.
+func readVideoReference(header *multipart.FileHeader) (providers.InputFile, error) {
+	if header.Size > maxVideoReferenceSize {
+		return providers.InputFile{}, fmt.Errorf("input_reference %q is larger than %d bytes", header.Filename, maxVideoReferenceSize)
+	}
+	opened, err := header.Open()
+	if err != nil {
+		return providers.InputFile{}, fmt.Errorf("read input_reference: %w", err)
+	}
+	defer opened.Close()
+	data, err := io.ReadAll(io.LimitReader(opened, maxVideoReferenceSize+1))
+	if err != nil || len(data) == 0 || len(data) > maxVideoReferenceSize {
+		return providers.InputFile{}, errors.New("input_reference must be a non-empty image of at most 10 MB")
+	}
+	mimeType := http.DetectContentType(data)
+	if !strings.HasPrefix(mimeType, "image/") {
+		return providers.InputFile{}, fmt.Errorf("input_reference %q is not an image", header.Filename)
+	}
+	return providers.InputFile{Name: header.Filename, MimeType: mimeType, Data: data}, nil
+}
