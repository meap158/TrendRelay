@@ -186,6 +200,29 @@ class BaseDownloader(ABC):
 
         return True
 
+    def _recorded_media_exists(self, recorded: str, aweme_id: str) -> bool:
+        # TrendRelay: rows from before the per-file recording recorded the
+        # post *directory*, so a bare is_file() re-downloaded whole held
+        # profiles. A directory counts when a file inside it carries the
+        # aweme id in its name - the same identity the local index matches.
+        candidate = Path(recorded)
+        if candidate.is_file():
+            return True
+        if not candidate.is_dir() or not aweme_id:
+            return False
+        cache = getattr(self, "_recorded_dir_cache", None)
+        if cache is None:
+            cache = {}
+            self._recorded_dir_cache = cache
+        listing = cache.get(recorded)
+        if listing is None:
+            try:
+                listing = [entry.name for entry in candidate.iterdir()]
+            except OSError:
+                listing = []
+            cache[recorded] = listing
+        return any(aweme_id in name for name in listing)
+
