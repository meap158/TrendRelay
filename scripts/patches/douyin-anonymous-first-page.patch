diff --git a/storage/database.py b/storage/database.py
index 8023e53..b25d17f 100644
--- a/storage/database.py
+++ b/storage/database.py
@@ -241,6 +241,19 @@ class Database:
         result = await cursor.fetchone()
         return result is not None
 
+    async def recorded_file_path(self, aweme_id: str) -> str:
+        # TrendRelay: where the post's file already lives, if anywhere. The
+        # caller checks existence; jobs download into per-job folders, so
+        # "not in this folder" says nothing about "not on disk".
+        db = await self._get_conn()
+        cursor = await db.execute(
+            "SELECT file_path FROM aweme WHERE aweme_id = ? "
+            "AND file_path IS NOT NULL AND file_path != ''",
+            (aweme_id,),
+        )
+        row = await cursor.fetchone()
+        return str(row[0]) if row and row[0] else ""
+
     # Preserving upsert: metadata-ish fields always update, but download
     # artifacts (file_path / metadata / download_time) and enrichments
     # (cover_urls / job_id) survive upserts that arrive without them.
