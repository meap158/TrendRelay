{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["workspace_id", "title", "source_asset", "source_rights", "pipeline", "budget_usd", "confirm_external_action"],
  "properties": {
    "workspace_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "title": {"type": "string", "minLength": 2, "maxLength": 160},
    "source_asset": {"type": "string", "minLength": 1},
    "source_rights": {"enum": ["owned", "licensed", "public-domain"]},
    "pipeline": {"enum": ["clip-factory", "podcast-repurpose"]},
    "target_platforms": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"enum": ["tiktok", "instagram", "youtube"]}},
    "clip_count": {"type": "integer", "minimum": 1, "maximum": 20},
    "budget_usd": {"type": "number", "minimum": 0, "maximum": 100},
    "confirm_external_action": {"const": true}
  },
  "additionalProperties": false
}
