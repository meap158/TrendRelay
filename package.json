{
  "name": "trendrelay",
  "version": "0.1.0",
  "private": true,
  "description": "Affiliate trend-to-content orchestration platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "python scripts/dev.py",
    "dev:check": "python scripts/dev.py --check",
    "dev:web": "npm run dev --workspace=@trendrelay/web",
    "dev:desktop": "npm run dev --workspace=@trendrelay/desktop",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "douyin": "python scripts/douyin.py",
    "postiz": "python scripts/postiz.py",
    "research": "python scripts/research.py",
    "studio": "python scripts/studio.py",
    "tools": "python scripts/tools.py"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@swc/core": "^1.15.43"
  }
}
