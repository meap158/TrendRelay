{
  "name": "trendrelay",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "description": "Affiliate trend-to-content orchestration platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "python scripts/dev.py",
    "dev:check": "python scripts/dev.py --check",
    "db": "python scripts/db.py",
    "dev:web": "npm run dev --workspace=@trendrelay/web",
    "dev:desktop": "npm run dev --workspace=@trendrelay/desktop",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "node scripts/run_pytest.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "release:check": "npm run check && npm run build",
    "douyin": "python scripts/douyin.py",
    "research": "python scripts/research.py",
    "tiktok": "python scripts/tiktok_creative.py",
    "reach": "python scripts/reach.py",
    "studio": "python scripts/studio.py",
    "tools": "python scripts/tools.py",
    "meta-ads": "python scripts/meta_ads.py"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "@derhuerst/ffprobe-static@5.3.0": true,
    "@swc/core@1.15.43": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "ffmpeg-static@5.3.0": true,
    "unrs-resolver@1.12.2": true
  },
  "devDependencies": {
    "@derhuerst/ffprobe-static": "^5.3.0",
    "@swc/core": "^1.15.43",
    "ffmpeg-static": "^5.3.0"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "sharp": "^0.35.0"
  }
}
