{
  "name": "trendrelay",
  "version": "0.1.0",
  "private": true,
  "description": "Affiliate trend-to-content orchestration platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "python scripts/dev.py",
    "dev:check": "python scripts/dev.py --check",
    "db": "python scripts/db.py",
    "dev:web": "npm run dev --workspace=@trendrelay/web",
    "dev:desktop": "npm run dev --workspace=@trendrelay/desktop",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "douyin": "python scripts/douyin.py",
    "postiz": "python scripts/postiz.py",
    "postiz:service": "python scripts/postiz_service.py",
    "research": "python scripts/research.py",
    "reach": "python scripts/reach.py",
    "studio": "python scripts/studio.py",
    "tools": "python scripts/tools.py",
    "meta-ads": "python scripts/meta_ads.py"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@derhuerst/ffprobe-static": "^5.3.0",
    "@swc/core": "^1.15.43",
    "ffmpeg-static": "^5.3.0"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "sharp": "^0.35.0"
  }
}
