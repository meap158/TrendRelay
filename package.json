{
  "name": "trendrelay",
  "version": "0.1.0",
  "private": true,
  "description": "Affiliate trend-to-content orchestration platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@trendrelay/web",
    "dev:web": "npm run dev --workspace=@trendrelay/web",
    "dev:desktop": "npm run dev --workspace=@trendrelay/desktop",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@swc/core": "^1.15.43"
  }
}
