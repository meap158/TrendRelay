POSTGRES_DB=trendrelay
POSTGRES_USER=trendrelay
POSTGRES_PASSWORD=trendrelay_dev
# Easy local default; use a PostgreSQL URL in shared/production environments.
DATABASE_URL=sqlite:///.data/trendrelay.db
SUPABASE_URL=
AUTH_AUDIENCE=authenticated
# Required in production; generated under .data for local development.
DEVICE_TOKEN_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=trendrelay
S3_SECRET_KEY=trendrelay_dev
S3_BUCKET=trendrelay-assets
API_PORT=8080
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional Douyin authentication; never commit real values.
DOUYIN_MS_TOKEN=
DOUYIN_TTWID=
DOUYIN_ODIN_TT=
DOUYIN_PASSPORT_CSRF_TOKEN=
DOUYIN_SID_GUARD=

# Optional Postiz API-key authentication; OAuth device login is preferred.
# Never commit real values. POSTIZ_API_URL may point to a self-hosted instance.
POSTIZ_API_KEY=
POSTIZ_API_URL=
# Optional Last 30 Days research providers. The adapter passes only these
# scoped values to the isolated research process; free sources need no key.
BRAVE_API_KEY=
EXA_API_KEY=
SERPER_API_KEY=
PARALLEL_API_KEY=
XAI_API_KEY=
XQUIK_API_KEY=
SCRAPECREATORS_API_KEY=
PERPLEXITY_API_KEY=
OPENROUTER_API_KEY=
