POSTGRES_DB=trendrelay
POSTGRES_USER=trendrelay
POSTGRES_PASSWORD=trendrelay_dev
# Easy local default; use a PostgreSQL URL in shared/production environments.
DATABASE_URL=sqlite:///.data/trendrelay.db
SUPABASE_URL=
AUTH_AUDIENCE=authenticated
# Development-only, loopback-only login bypass. Set false to exercise real auth locally.
LOCAL_AUTH_BYPASS=true
# Optional policy: require a verified MFA session for governed browser actions.
REQUIRE_AAL2_FOR_GOVERNED_ACTIONS=false
# Required in production; generated under .data for local development.
DEVICE_TOKEN_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=trendrelay
S3_SECRET_KEY=trendrelay_dev
S3_BUCKET=trendrelay-assets
API_PORT=8011
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
NEXT_PUBLIC_API_URL=http://127.0.0.1:8011
# Public first-party redirect origin. Use a dedicated HTTPS host in production.
ATTRIBUTION_PUBLIC_URL=http://127.0.0.1:8011
# Enables daily HMAC visitor pseudonyms and keyed conversion-reference hashes.
ATTRIBUTION_HASH_SECRET=
# Comma-separated local directories from which approved MP4s may be published.
PUBLISHING_MEDIA_ROOTS=.data/downloads,.data/media,.data/productions

# Optional SMTP invitation delivery. Raw invitation tokens are never persisted.
PUBLIC_WEB_URL=http://localhost:3001
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_SECURITY=starttls
INVITATION_DELIVERY_HOURLY_LIMIT=20

# Douyin authentication (required for media downloads). Prefer the in-app
# Connect Douyin button; CLI equivalent: npm run douyin -- connect
# This opens login, detects session cookies automatically, and saves them under
# .data/douyin/cookies.json. Alternatively set either a
# full cookie header or the discrete keys below. Never commit real values.
DOUYIN_COOKIE=
DOUYIN_MS_TOKEN=
DOUYIN_TTWID=
DOUYIN_ODIN_TT=
DOUYIN_PASSPORT_CSRF_TOKEN=
DOUYIN_SID_GUARD=

# Social publishing engine. One of: bundle_social, zernio, buffer.
# All three are configurable from the Publish screen, which writes back here.
PUBLISHING_PROVIDER=bundle_social
# Bundle.social - multi-tenant SaaS engine (https://bundle.social).
BUNDLE_SOCIAL_API_KEY=
BUNDLE_SOCIAL_TEAM_ID=
# Zernio - single-tenant bearer-token engine (https://zernio.com).
ZERNIO_API_KEY=
# Buffer - GraphQL queue gateway (https://publish.buffer.com/settings/api).
# Media must already be hosted at a public URL; Buffer has no upload endpoint.
BUFFER_API_KEY=
BUFFER_ORGANIZATION_ID=
# Optional Last 30 Days research providers. The adapter passes only these
# scoped values to the isolated research process; free sources need no key.
BRAVE_API_KEY=
EXA_API_KEY=
SERPER_API_KEY=
PARALLEL_API_KEY=
XAI_API_KEY=
XQUIK_API_KEY=
SCRAPECREATORS_API_KEY=
PERPLEXITY_API_KEY=
OPENROUTER_API_KEY=
# Optional non-secret default for the read-only Meta Ads briefing.
# Authentication stays in the isolated Social Flow CLI profile.
META_AD_ACCOUNT=
# Local Media AI. Install/prepare providers from the Tools page. Analysis is
# offline after setup; all machine text remains a draft until operator review.
MEDIA_AI_SPEECH_MODEL=base
MEDIA_AI_DEVICE=cpu
MEDIA_AI_COMPUTE_TYPE=int8
MEDIA_AI_OCR_INTERVAL_SECONDS=2.0
MEDIA_AI_MAX_OCR_FRAMES=60