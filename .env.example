POSTGRES_DB=trendrelay
POSTGRES_USER=trendrelay
POSTGRES_PASSWORD=trendrelay_dev
# Easy local default; use a PostgreSQL URL in shared/production environments.
DATABASE_URL=sqlite:///.data/trendrelay.db
SUPABASE_URL=
AUTH_AUDIENCE=authenticated
# Development-only, loopback-only login bypass. Set false to exercise real auth locally.
LOCAL_AUTH_BYPASS=true
# Optional policy: require a verified MFA session for governed browser actions.
REQUIRE_AAL2_FOR_GOVERNED_ACTIONS=false
# Required in production; generated under .data for local development.
DEVICE_TOKEN_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=trendrelay
S3_SECRET_KEY=trendrelay_dev
S3_BUCKET=trendrelay-assets
API_PORT=8011
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
NEXT_PUBLIC_API_URL=http://127.0.0.1:8011
# Public first-party redirect origin. Use a dedicated HTTPS host in production.
ATTRIBUTION_PUBLIC_URL=http://127.0.0.1:8011
# Enables daily HMAC visitor pseudonyms and keyed conversion-reference hashes.
ATTRIBUTION_HASH_SECRET=
# Comma-separated local directories from which approved MP4s may be published.
PUBLISHING_MEDIA_ROOTS=.data/downloads,.data/media,.data/productions

# Optional SMTP invitation delivery. Raw invitation tokens are never persisted.
PUBLIC_WEB_URL=http://localhost:3001
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_SECURITY=starttls
INVITATION_DELIVERY_HOURLY_LIMIT=20

# Douyin authentication (required for media downloads). Prefer the in-app
# Connect Douyin button; CLI equivalent: npm run douyin -- connect
# This opens login, detects session cookies automatically, and saves them under
# .data/douyin/cookies.json. Alternatively set either a
# full cookie header or the discrete keys below. Never commit real values.
DOUYIN_COOKIE=
DOUYIN_MS_TOKEN=
DOUYIN_TTWID=
DOUYIN_ODIN_TT=
DOUYIN_PASSPORT_CSRF_TOKEN=
DOUYIN_SID_GUARD=

# Social publishing engine. One of: bundle_social, zernio, buffer, woopsocial.
# This names the default only: a single post can address destinations on
# several engines at once. All four are configurable from the Publish screen,
# which writes back here.
PUBLISHING_PROVIDER=bundle_social
# Bundle.social - multi-tenant SaaS engine (https://bundle.social).
BUNDLE_SOCIAL_API_KEY=
BUNDLE_SOCIAL_TEAM_ID=
# Zernio - single-tenant bearer-token engine (https://zernio.com).
ZERNIO_API_KEY=
# Buffer - GraphQL queue gateway (https://publish.buffer.com/settings/api).
# Media must already be hosted at a public URL; Buffer has no upload endpoint.
BUFFER_API_KEY=
BUFFER_ORGANIZATION_ID=
# WoopSocial - bearer-token engine (https://app.woopsocial.com/api-access).
# Uploads media directly, so it needs no public URL. The project ID is optional
# and only matters when the account has more than one.
WOOPSOCIAL_API_KEY=
WOOPSOCIAL_PROJECT_ID=

# Media hosting for engines that fetch rather than accept an upload - which
# today means Buffer. Without it, Buffer cannot publish a local clip at all.
#
# Every value on the R2 bucket page is a 32-character hex string or a URL, and
# the fields do not say which is which, so two mistakes are easy and neither is
# reported until a publish fails: the S3 API endpoint pasted as the secret, and
# the account ID pasted as the access key. They are different values - create an
# API token under R2 -> API with Object Read & Write. "Test access" on the
# Publish screen checks the whole path, including that the public URL serves
# what was written.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# Optional Last 30 Days research providers. The adapter passes only these
# scoped values to the isolated research process; free sources need no key.
BRAVE_API_KEY=
EXA_API_KEY=
SERPER_API_KEY=
PARALLEL_API_KEY=
XAI_API_KEY=
XQUIK_API_KEY=
SCRAPECREATORS_API_KEY=
PERPLEXITY_API_KEY=
OPENROUTER_API_KEY=
# Optional official regional popular-video source for Discover.
YOUTUBE_DATA_API_KEY=
# Optional non-secret default for the read-only Meta Ads briefing.
# Authentication stays in the isolated Social Flow CLI profile.
META_AD_ACCOUNT=
# Local Media AI. Install/prepare providers from the Tools page. Analysis is
# offline after setup; all machine text remains a draft until operator review.
MEDIA_AI_SPEECH_MODEL=base
# auto picks CUDA when a usable cuBLAS runtime is present, else CPU.
MEDIA_AI_DEVICE=auto
# auto resolves int8 on CPU / float16 on CUDA.
MEDIA_AI_COMPUTE_TYPE=auto
# 0 lets the resolver pick from core count; only meaningful on CPU.
MEDIA_AI_CPU_THREADS=0
# Chunked batching: higher is faster on long audio, costs more memory.
MEDIA_AI_SPEECH_BATCH_SIZE=8
# 5 = default quality. 1 (greedy) is roughly twice as fast with a small
# accuracy cost on noisy speech.
MEDIA_AI_SPEECH_BEAM_SIZE=5
MEDIA_AI_OCR_INTERVAL_SECONDS=2.0
MEDIA_AI_MAX_OCR_FRAMES=60
# Assistant access over MCP. The server runs on loopback (start it from the
# Tools tab, or configure a tunnel below and the launcher starts both). It
# serves MCP_WORKSPACE_ID, or the local operator's own workspace when empty.
MCP_PORT=8765
MCP_WORKSPACE_ID=
# Reaching the MCP server from an outside assistant. Set BOTH the tunnel id and
# the runtime API key (Tunnels Read + Use; not an admin key) from
# platform.openai.com, and the launcher dials the control plane outward - nothing
# binds a public address. Leave either empty and the server stays on loopback.
CONTROL_PLANE_TUNNEL_ID=
CONTROL_PLANE_API_KEY=
# Optional: full path to tunnel-client if it is not on PATH, its log level, and
# a fixed health port (a free one is chosen when unset).
TUNNEL_CLIENT_BIN=
TUNNEL_LOG_LEVEL=warn
TUNNEL_HEALTH_PORT=
